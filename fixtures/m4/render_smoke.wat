;; M4 dedicated render smoke: clear color → present (flat u32 reps, not WIT resources).
(component
  (import "experimental:webgpu-cm/host@0.8.0" (instance $host
    (export "request-adapter" (func (result u32)))
    (export "adapter-request-device" (func (param "adapter" u32) (result u32)))
    (export "device-get-queue" (func (param "device" u32) (result u32)))
    (export "create-surface-from-native-window" (func (param "window" u64) (result u32)))
    (export "surface-configure"
      (func (param "surface" u32) (param "device" u32) (param "adapter" u32)
            (param "width" u32) (param "height" u32) (result u32)))
    (export "surface-get-current-texture-view" (func (param "surface" u32) (result u32)))
    (export "device-create-command-encoder" (func (param "device" u32) (result u32)))
    (export "command-encoder-begin-render-pass-clear"
      (func (param "encoder" u32) (param "view" u32) (result u32)))
    (export "render-pass-end" (func (param "pass" u32)))
    (export "command-encoder-finish" (func (param "encoder" u32) (result u32)))
    (export "queue-submit1" (func (param "queue" u32) (param "commands" u32)))
    (export "surface-present" (func (param "surface" u32)))
    (export "surface-unconfigure" (func (param "surface" u32)))
  ))

  (alias export $host "request-adapter" (func $request-adapter))
  (alias export $host "adapter-request-device" (func $adapter-request-device))
  (alias export $host "device-get-queue" (func $device-get-queue))
  (alias export $host "create-surface-from-native-window" (func $create-surface))
  (alias export $host "surface-configure" (func $surface-configure))
  (alias export $host "surface-get-current-texture-view" (func $get-view))
  (alias export $host "device-create-command-encoder" (func $create-encoder))
  (alias export $host "command-encoder-begin-render-pass-clear" (func $begin-clear))
  (alias export $host "render-pass-end" (func $pass-end))
  (alias export $host "command-encoder-finish" (func $finish))
  (alias export $host "queue-submit1" (func $submit1))
  (alias export $host "surface-present" (func $present))
  (alias export $host "surface-unconfigure" (func $unconfigure))

  (core module $m
    (import "" "request-adapter" (func $request-adapter (result i32)))
    (import "" "adapter-request-device" (func $adapter-request-device (param i32) (result i32)))
    (import "" "device-get-queue" (func $device-get-queue (param i32) (result i32)))
    (import "" "create-surface" (func $create-surface (param i64) (result i32)))
    (import "" "surface-configure"
      (func $surface-configure (param i32 i32 i32 i32 i32) (result i32)))
    (import "" "get-view" (func $get-view (param i32) (result i32)))
    (import "" "create-encoder" (func $create-encoder (param i32) (result i32)))
    (import "" "begin-clear" (func $begin-clear (param i32 i32) (result i32)))
    (import "" "pass-end" (func $pass-end (param i32)))
    (import "" "finish" (func $finish (param i32) (result i32)))
    (import "" "submit1" (func $submit1 (param i32 i32)))
    (import "" "present" (func $present (param i32)))
    (import "" "unconfigure" (func $unconfigure (param i32)))

    (func (export "run-clear") (param $window i64) (param $w i32) (param $h i32) (result i32)
      (local $adapter i32)
      (local $device i32)
      (local $queue i32)
      (local $surface i32)
      (local $view i32)
      (local $encoder i32)
      (local $pass i32)
      (local $commands i32)

      (local.set $adapter (call $request-adapter))
      (local.set $device (call $adapter-request-device (local.get $adapter)))
      (local.set $queue (call $device-get-queue (local.get $device)))
      (local.set $surface (call $create-surface (local.get $window)))
      (drop (call $surface-configure
        (local.get $surface) (local.get $device) (local.get $adapter)
        (local.get $w) (local.get $h)))
      (local.set $view (call $get-view (local.get $surface)))
      (local.set $encoder (call $create-encoder (local.get $device)))
      (local.set $pass (call $begin-clear (local.get $encoder) (local.get $view)))
      (call $pass-end (local.get $pass))
      (local.set $commands (call $finish (local.get $encoder)))
      (call $submit1 (local.get $queue) (local.get $commands))
      (call $present (local.get $surface))
      (call $unconfigure (local.get $surface))
      (i32.const 0)
    )
  )

  (core func $request-adapter_l (canon lower (func $request-adapter)))
  (core func $adapter-request-device_l (canon lower (func $adapter-request-device)))
  (core func $device-get-queue_l (canon lower (func $device-get-queue)))
  (core func $create-surface_l (canon lower (func $create-surface)))
  (core func $surface-configure_l (canon lower (func $surface-configure)))
  (core func $get-view_l (canon lower (func $get-view)))
  (core func $create-encoder_l (canon lower (func $create-encoder)))
  (core func $begin-clear_l (canon lower (func $begin-clear)))
  (core func $pass-end_l (canon lower (func $pass-end)))
  (core func $finish_l (canon lower (func $finish)))
  (core func $submit1_l (canon lower (func $submit1)))
  (core func $present_l (canon lower (func $present)))
  (core func $unconfigure_l (canon lower (func $unconfigure)))

  (core instance $i (instantiate $m
    (with "" (instance
      (export "request-adapter" (func $request-adapter_l))
      (export "adapter-request-device" (func $adapter-request-device_l))
      (export "device-get-queue" (func $device-get-queue_l))
      (export "create-surface" (func $create-surface_l))
      (export "surface-configure" (func $surface-configure_l))
      (export "get-view" (func $get-view_l))
      (export "create-encoder" (func $create-encoder_l))
      (export "begin-clear" (func $begin-clear_l))
      (export "pass-end" (func $pass-end_l))
      (export "finish" (func $finish_l))
      (export "submit1" (func $submit1_l))
      (export "present" (func $present_l))
      (export "unconfigure" (func $unconfigure_l))
    ))
  ))

  (func (export "run-clear") (param "window" u64) (param "width" u32) (param "height" u32) (result u32)
    (canon lift (core func $i "run-clear"))
  )
)
