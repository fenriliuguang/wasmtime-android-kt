;; P010-GFXL: product guest on-frame loop (2 frames).
;; surface ctor → surface-webgpu context → configure → on-frame stream →
;; each event: get-current-texture → queue.submit → context.present.
;; GPU bootstrap still uses fixture get-device (P010-FIX). get-queue /
;; get-command-buffer are existing product leftovers (rep 0). Returns 2.
;; No JS callback. No stackful CM async (events pre-buffered on GpuThread).
(component
  (import "wasi:webgpu/webgpu@0.3.0-rc.2" (instance $webgpu
    (type $fmt (enum "r8unorm" "r8snorm" "r8uint" "r8sint" "r16unorm" "r16snorm" "r16uint" "r16sint" "r16float" "rg8unorm" "rg8snorm" "rg8uint" "rg8sint" "r32uint" "r32sint" "r32float" "rg16unorm" "rg16snorm" "rg16uint" "rg16sint" "rg16float" "rgba8unorm" "rgba8unorm-srgb" "rgba8snorm" "rgba8uint" "rgba8sint" "bgra8unorm" "bgra8unorm-srgb" "rgb9e5ufloat" "rgb10a2uint" "rgb10a2unorm" "rg11b10ufloat" "rg32uint" "rg32sint" "rg32float" "rgba16unorm" "rgba16snorm" "rgba16uint" "rgba16sint" "rgba16float" "rgba32uint" "rgba32sint" "rgba32float" "stencil8" "depth16unorm" "depth24plus" "depth24plus-stencil8" "depth32float" "depth32float-stencil8" "bc1-rgba-unorm" "bc1-rgba-unorm-srgb" "bc2-rgba-unorm" "bc2-rgba-unorm-srgb" "bc3-rgba-unorm" "bc3-rgba-unorm-srgb" "bc4-r-unorm" "bc4-r-snorm" "bc5-rg-unorm" "bc5-rg-snorm" "bc6h-rgb-ufloat" "bc6h-rgb-float" "bc7-rgba-unorm" "bc7-rgba-unorm-srgb" "etc2-rgb8unorm" "etc2-rgb8unorm-srgb" "etc2-rgb8a1unorm" "etc2-rgb8a1unorm-srgb" "etc2-rgba8unorm" "etc2-rgba8unorm-srgb" "eac-r11unorm" "eac-r11snorm" "eac-rg11unorm" "eac-rg11snorm" "astc4x4-unorm" "astc4x4-unorm-srgb" "astc5x4-unorm" "astc5x4-unorm-srgb" "astc5x5-unorm" "astc5x5-unorm-srgb" "astc6x5-unorm" "astc6x5-unorm-srgb" "astc6x6-unorm" "astc6x6-unorm-srgb" "astc8x5-unorm" "astc8x5-unorm-srgb" "astc8x6-unorm" "astc8x6-unorm-srgb" "astc8x8-unorm" "astc8x8-unorm-srgb" "astc10x5-unorm" "astc10x5-unorm-srgb" "astc10x6-unorm" "astc10x6-unorm-srgb" "astc10x8-unorm" "astc10x8-unorm-srgb" "astc10x10-unorm" "astc10x10-unorm-srgb" "astc12x10-unorm" "astc12x10-unorm-srgb" "astc12x12-unorm" "astc12x12-unorm-srgb"))
    (export "gpu-texture-format" (type (eq $fmt)))
    (type $usage (flags "copy-src" "copy-dst" "texture-binding" "storage-binding" "render-attachment" "transient-attachment"))
    (export "gpu-texture-usage" (type (eq $usage)))
    (type $cs (enum "srgb" "display-p3"))
    (export "predefined-color-space" (type (eq $cs)))
    (type $alpha (enum "opaque" "premultiplied"))
    (export "gpu-canvas-alpha-mode" (type (eq $alpha)))
    (type $tm-mode (enum "standard" "extended"))
    (export "gpu-canvas-tone-mapping-mode" (type (eq $tm-mode)))
    (type $opt-tm-mode (option 9))
    (type $tm (record (field "mode" $opt-tm-mode)))
    (export "gpu-canvas-tone-mapping" (type (eq $tm)))
    (export "gpu-device" (type $gpu-device (sub resource)))
    (export "gpu-texture" (type $gpu-texture (sub resource)))
    (export "gpu-queue" (type $gpu-queue (sub resource)))
    (export "gpu-command-buffer" (type $gpu-command-buffer (sub resource)))
    (type $own-device (own $gpu-device))
    (export "get-device" (func (result $own-device)))
    (type $own-queue (own $gpu-queue))
    (export "get-queue" (func (result $own-queue)))
    (type $own-cb (own $gpu-command-buffer))
    (export "get-command-buffer" (func (result $own-cb)))
    (type $borrow-queue (borrow $gpu-queue))
    (type $borrow-cb (borrow $gpu-command-buffer))
    (type $list-cb (list $borrow-cb))
    (export "[method]gpu-queue.submit"
      (func (param "self" $borrow-queue) (param "command-buffers" $list-cb)))
  ))
  (import "wasi-gfx:surface/surface@0.2.0" (instance $surf
    (export "surface" (type $surface (sub resource)))
    (type $create-desc-def (record
      (field "height" (option u32))
      (field "width" (option u32))))
    (export "create-desc" (type $create-desc (eq $create-desc-def)))
    (type $frame-event-def (record (field "nothing" bool)))
    (export "frame-event" (type $frame-event (eq $frame-event-def)))
    (type $st (stream $frame-event))
    (type $borrow-surf (borrow $surface))
    (export "[constructor]surface"
      (func (param "desc" $create-desc) (result (own $surface))))
    (export "[method]surface.on-frame"
      (func (param "self" $borrow-surf) (result $st)))
  ))
  (alias export $webgpu "gpu-device" (type $gpu-device))
  (alias export $webgpu "gpu-texture" (type $gpu-texture))
  (alias export $webgpu "gpu-texture-format" (type $gpu-texture-format))
  (alias export $webgpu "gpu-texture-usage" (type $gpu-texture-usage))
  (alias export $webgpu "predefined-color-space" (type $predefined-color-space))
  (alias export $webgpu "gpu-canvas-tone-mapping" (type $gpu-canvas-tone-mapping))
  (alias export $webgpu "gpu-canvas-alpha-mode" (type $gpu-canvas-alpha-mode))
  (alias export $surf "surface" (type $surface))
  (import "wasi-gfx:surface/surface-webgpu@0.2.0" (instance $sw
    (export "gpu-device" (type (eq $gpu-device)))
    (export "gpu-texture" (type (eq $gpu-texture)))
    (export "gpu-texture-format" (type (eq $gpu-texture-format)))
    (export "gpu-texture-usage" (type (eq $gpu-texture-usage)))
    (export "predefined-color-space" (type (eq $predefined-color-space)))
    (export "gpu-canvas-tone-mapping" (type (eq $gpu-canvas-tone-mapping)))
    (export "gpu-canvas-alpha-mode" (type (eq $gpu-canvas-alpha-mode)))
    (export "surface" (type (eq $surface)))
    (export "context" (type $context (sub resource)))
    (type $borrow-device (borrow $gpu-device))
    (type $opt-usage (option $gpu-texture-usage))
    (type $list-fmt (list $gpu-texture-format))
    (type $opt-list-fmt (option $list-fmt))
    (type $opt-cs (option $predefined-color-space))
    (type $opt-tm (option $gpu-canvas-tone-mapping))
    (type $opt-alpha (option $gpu-canvas-alpha-mode))
    (type $cfg-def (record
      (field "device" $borrow-device)
      (field "format" $gpu-texture-format)
      (field "usage" $opt-usage)
      (field "view-formats" $opt-list-fmt)
      (field "color-space" $opt-cs)
      (field "tone-mapping" $opt-tm)
      (field "alpha-mode" $opt-alpha)))
    (export "context-configuration" (type $cfg (eq $cfg-def)))
    (type $borrow-surf (borrow $surface))
    (type $borrow-ctx (borrow $context))
    (export "[constructor]context"
      (func (param "surface" $borrow-surf) (result (own $context))))
    (export "[method]context.configure"
      (func (param "self" $borrow-ctx) (param "configuration" $cfg)))
    (export "[method]context.get-current-texture"
      (func (param "self" $borrow-ctx) (result (own $gpu-texture))))
    (export "[method]context.present"
      (func (param "self" $borrow-ctx)))
  ))
  (alias export $webgpu "get-device" (func $get-device))
  (alias export $webgpu "get-queue" (func $get-queue))
  (alias export $webgpu "get-command-buffer" (func $get-command-buffer))
  (alias export $webgpu "[method]gpu-queue.submit" (func $submit))
  (alias export $webgpu "gpu-queue" (type $gpu-queue))
  (alias export $webgpu "gpu-command-buffer" (type $gpu-command-buffer))
  (alias export $surf "[constructor]surface" (func $ctor-surf))
  (alias export $surf "[method]surface.on-frame" (func $on-frame))
  (alias export $surf "frame-event" (type $frame-event))
  (alias export $sw "[constructor]context" (func $ctor-ctx))
  (alias export $sw "[method]context.configure" (func $configure))
  (alias export $sw "[method]context.get-current-texture" (func $get-tex))
  (alias export $sw "[method]context.present" (func $present))
  (type $st (stream $frame-event))

  (core module $builtins
    (memory (export "mem") 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (i32.const 256)
    )
  )
  (core instance $builtins (instantiate $builtins))

  (core module $m
    (import "" "mem" (memory 1))
    (import "" "ctor-surf" (func $ctor-surf (param i32 i32 i32 i32) (result i32)))
    (import "" "on-frame" (func $on-frame (param i32) (result i32)))
    (import "" "stream.read" (func $stream.read (param i32 i32 i32) (result i32)))
    (import "" "stream.drop-readable" (func $stream.drop-readable (param i32)))
    (import "" "ctor-ctx" (func $ctor-ctx (param i32) (result i32)))
    (import "" "configure" (func $configure
      (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "" "get-tex" (func $get-tex (param i32) (result i32)))
    (import "" "present" (func $present (param i32)))
    (import "" "get-device" (func $get-device (result i32)))
    (import "" "get-queue" (func $get-queue (result i32)))
    (import "" "get-command-buffer" (func $get-command-buffer (result i32)))
    (import "" "submit" (func $submit (param i32 i32 i32)))
    (import "" "drop-queue" (func $drop-queue (param i32)))
    (import "" "drop-cb" (func $drop-cb (param i32)))
    (import "" "drop-tex" (func $drop-tex (param i32)))

    (func (export "run") (result i32)
      (local $surf i32)
      (local $ctx i32)
      (local $device i32)
      (local $stream i32)
      (local $status i32)
      (local $n i32)
      (local $frames i32)
      (local $tex i32)
      (local $queue i32)
      (local $cb i32)

      (local.set $surf (call $ctor-surf
        (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
      (local.set $ctx (call $ctor-ctx (local.get $surf)))
      (local.set $device (call $get-device))
      (call $configure
        (local.get $ctx)
        (local.get $device)
        (i32.const 21)
        (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0))
      (local.set $stream (call $on-frame (local.get $surf)))
      (block $done
        (loop $frames
          (local.set $status (call $stream.read (local.get $stream) (i32.const 32) (i32.const 1)))
          (if (i32.eq (local.get $status) (i32.const -1))
            (then unreachable))
          (local.set $n (i32.shr_u (local.get $status) (i32.const 4)))
          (if (i32.eqz (local.get $n))
            (then (br $done)))
          (local.set $tex (call $get-tex (local.get $ctx)))
          (local.set $queue (call $get-queue))
          (local.set $cb (call $get-command-buffer))
          (i32.store (i32.const 16) (local.get $cb))
          (call $submit (local.get $queue) (i32.const 16) (i32.const 1))
          (call $present (local.get $ctx))
          (call $drop-cb (local.get $cb))
          (call $drop-queue (local.get $queue))
          (call $drop-tex (local.get $tex))
          (local.set $frames (i32.add (local.get $frames) (i32.const 1)))
          (br $frames)
        )
      )
      (call $stream.drop-readable (local.get $stream))
      (local.get $frames)
    )
  )

  (core func $ctor_surf_lower (canon lower (func $ctor-surf)))
  (core func $on_frame_lower (canon lower (func $on-frame)))
  (core func $stream.read (canon stream.read $st async (memory $builtins "mem")))
  (core func $stream.drop-readable (canon stream.drop-readable $st))
  (core func $ctor_ctx_lower (canon lower (func $ctor-ctx)))
  (core func $configure_lower
    (canon lower (func $configure)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $get_tex_lower (canon lower (func $get-tex)))
  (core func $present_lower (canon lower (func $present)))
  (core func $gd_lower (canon lower (func $get-device)))
  (core func $gq_lower (canon lower (func $get-queue)))
  (core func $gcb_lower (canon lower (func $get-command-buffer)))
  (core func $submit_lower
    (canon lower (func $submit)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $dq_lower (canon resource.drop $gpu-queue))
  (core func $dcb_lower (canon resource.drop $gpu-command-buffer))
  (core func $dtex_lower (canon resource.drop $gpu-texture))

  (core instance $i (instantiate $m
    (with "" (instance
      (export "mem" (memory $builtins "mem"))
      (export "ctor-surf" (func $ctor_surf_lower))
      (export "on-frame" (func $on_frame_lower))
      (export "stream.read" (func $stream.read))
      (export "stream.drop-readable" (func $stream.drop-readable))
      (export "ctor-ctx" (func $ctor_ctx_lower))
      (export "configure" (func $configure_lower))
      (export "get-tex" (func $get_tex_lower))
      (export "present" (func $present_lower))
      (export "get-device" (func $gd_lower))
      (export "get-queue" (func $gq_lower))
      (export "get-command-buffer" (func $gcb_lower))
      (export "submit" (func $submit_lower))
      (export "drop-queue" (func $dq_lower))
      (export "drop-cb" (func $dcb_lower))
      (export "drop-tex" (func $dtex_lower))
    ))
  ))

  (func (export "run") async (result u32)
    (canon lift (core func $i "run")))
)
