;; S6+: wasi:webgpu/webgpu@0.3.0-rc.2 get-device + get-shader-module +
;; [method]gpu-device.create-render-pipeline-async
;; WIT: create-render-pipeline-async: async func(descriptor)
;;      -> result<gpu-render-pipeline, create-pipeline-error>
;; Guest passes shader borrow, vertex entry-point="vs_main", buffers/primitive/depth/ms/fragment none,
;; layout=auto, label="l2"; drops own pipeline on ok; run returns harness 1.
;; Flattened params exceed 16, so canon lower spills through memory.
;; Spill tuple: device @0, vertex.module @16, vertex entry-point @20, layout disc auto @180,
;; label @188; retptr @512; strings at 768/784.
;; L2 described vertex shader/entry + layout + label. True CM async.
;; get-device / get-shader-module are test constructors only (not product WIT).
(component
  (import "wasi:webgpu/webgpu@0.3.0-rc.2" (instance $webgpu
    (export "gpu-shader-module" (type $gpu-shader-module (sub resource)))
    (export "gpu-pipeline-layout" (type $gpu-pipeline-layout (sub resource)))
    (export "record-gpu-pipeline-constant-value" (type $record-const (sub resource)))
    (type $borrow-pll (borrow $gpu-pipeline-layout))
    (type $layout-mode-def (variant
      (case "specific" $borrow-pll)
      (case "auto")
    ))
    (export "gpu-layout-mode" (type $gpu-layout-mode (eq $layout-mode-def)))
    (type $borrow-shader (borrow $gpu-shader-module))
    (type $opt-str (option string))
    (type $own-const (own $record-const))
    (type $opt-const (option $own-const))
    (type $vf (enum "uint8" "uint8x2" "uint8x4" "sint8" "sint8x2" "sint8x4" "unorm8" "unorm8x2" "unorm8x4" "snorm8" "snorm8x2" "snorm8x4" "uint16" "uint16x2" "uint16x4" "sint16" "sint16x2" "sint16x4" "unorm16" "unorm16x2" "unorm16x4" "snorm16" "snorm16x2" "snorm16x4" "float16" "float16x2" "float16x4" "float32" "float32x2" "float32x3" "float32x4" "uint32" "uint32x2" "uint32x3" "uint32x4" "sint32" "sint32x2" "sint32x3" "sint32x4" "unorm1010102" "unorm8x4-bgra"))
    (export "gpu-vertex-format" (type $gpu-vertex-format (eq $vf)))
    (type $attr (record
      (field "format" $gpu-vertex-format)
      (field "offset" u64)
      (field "shader-location" u32)
    ))
    (export "gpu-vertex-attribute" (type $gpu-vertex-attribute (eq $attr)))
    (type $step (enum "vertex" "instance"))
    (export "gpu-vertex-step-mode" (type $gpu-vertex-step-mode (eq $step)))
    (type $opt-step (option $gpu-vertex-step-mode))
    (type $list-attr (list $gpu-vertex-attribute))
    (type $vbl (record
      (field "array-stride" u64)
      (field "step-mode" $opt-step)
      (field "attributes" $list-attr)
    ))
    (export "gpu-vertex-buffer-layout" (type $gpu-vertex-buffer-layout (eq $vbl)))
    (type $opt-vbl (option $gpu-vertex-buffer-layout))
    (type $list-opt-vbl (list $opt-vbl))
    (type $opt-list-vbl (option $list-opt-vbl))
    (type $vs (record
      (field "buffers" $opt-list-vbl)
      (field "module" $borrow-shader)
      (field "entry-point" $opt-str)
      (field "constants" $opt-const)
    ))
    (export "gpu-vertex-state" (type $gpu-vertex-state (eq $vs)))
    (type $topo (enum "point-list" "line-list" "line-strip" "triangle-list" "triangle-strip"))
    (export "gpu-primitive-topology" (type $gpu-primitive-topology (eq $topo)))
    (type $idxf (enum "uint16" "uint32"))
    (export "gpu-index-format" (type $gpu-index-format (eq $idxf)))
    (type $ff (enum "ccw" "cw"))
    (export "gpu-front-face" (type $gpu-front-face (eq $ff)))
    (type $cull (enum "none" "front" "back"))
    (export "gpu-cull-mode" (type $gpu-cull-mode (eq $cull)))
    (type $opt-topo (option $gpu-primitive-topology))
    (type $opt-idxf (option $gpu-index-format))
    (type $opt-ff (option $gpu-front-face))
    (type $opt-cull (option $gpu-cull-mode))
    (type $opt-bool (option bool))
    (type $ps (record
      (field "topology" $opt-topo)
      (field "strip-index-format" $opt-idxf)
      (field "front-face" $opt-ff)
      (field "cull-mode" $opt-cull)
      (field "unclipped-depth" $opt-bool)
    ))
    (export "gpu-primitive-state" (type $gpu-primitive-state (eq $ps)))
    (type $opt-ps (option $gpu-primitive-state))
    (type $cmp (enum "never" "less" "equal" "less-equal" "greater" "not-equal" "greater-equal" "always"))
    (export "gpu-compare-function" (type $gpu-compare-function (eq $cmp)))
    (type $sop (enum "keep" "zero" "replace" "invert" "increment-clamp" "decrement-clamp" "increment-wrap" "decrement-wrap"))
    (export "gpu-stencil-operation" (type $gpu-stencil-operation (eq $sop)))
    (type $opt-cmp (option $gpu-compare-function))
    (type $opt-sop (option $gpu-stencil-operation))
    (type $sfs (record
      (field "compare" $opt-cmp)
      (field "fail-op" $opt-sop)
      (field "depth-fail-op" $opt-sop)
      (field "pass-op" $opt-sop)
    ))
    (export "gpu-stencil-face-state" (type $gpu-stencil-face-state (eq $sfs)))
    (type $opt-sfs (option $gpu-stencil-face-state))
    (type $fmt (enum "r8unorm" "r8snorm" "r8uint" "r8sint" "r16unorm" "r16snorm" "r16uint" "r16sint" "r16float" "rg8unorm" "rg8snorm" "rg8uint" "rg8sint" "r32uint" "r32sint" "r32float" "rg16unorm" "rg16snorm" "rg16uint" "rg16sint" "rg16float" "rgba8unorm" "rgba8unorm-srgb" "rgba8snorm" "rgba8uint" "rgba8sint" "bgra8unorm" "bgra8unorm-srgb" "rgb9e5ufloat" "rgb10a2uint" "rgb10a2unorm" "rg11b10ufloat" "rg32uint" "rg32sint" "rg32float" "rgba16unorm" "rgba16snorm" "rgba16uint" "rgba16sint" "rgba16float" "rgba32uint" "rgba32sint" "rgba32float" "stencil8" "depth16unorm" "depth24plus" "depth24plus-stencil8" "depth32float" "depth32float-stencil8" "bc1-rgba-unorm" "bc1-rgba-unorm-srgb" "bc2-rgba-unorm" "bc2-rgba-unorm-srgb" "bc3-rgba-unorm" "bc3-rgba-unorm-srgb" "bc4-r-unorm" "bc4-r-snorm" "bc5-rg-unorm" "bc5-rg-snorm" "bc6h-rgb-ufloat" "bc6h-rgb-float" "bc7-rgba-unorm" "bc7-rgba-unorm-srgb" "etc2-rgb8unorm" "etc2-rgb8unorm-srgb" "etc2-rgb8a1unorm" "etc2-rgb8a1unorm-srgb" "etc2-rgba8unorm" "etc2-rgba8unorm-srgb" "eac-r11unorm" "eac-r11snorm" "eac-rg11unorm" "eac-rg11snorm" "astc4x4-unorm" "astc4x4-unorm-srgb" "astc5x4-unorm" "astc5x4-unorm-srgb" "astc5x5-unorm" "astc5x5-unorm-srgb" "astc6x5-unorm" "astc6x5-unorm-srgb" "astc6x6-unorm" "astc6x6-unorm-srgb" "astc8x5-unorm" "astc8x5-unorm-srgb" "astc8x6-unorm" "astc8x6-unorm-srgb" "astc8x8-unorm" "astc8x8-unorm-srgb" "astc10x5-unorm" "astc10x5-unorm-srgb" "astc10x6-unorm" "astc10x6-unorm-srgb" "astc10x8-unorm" "astc10x8-unorm-srgb" "astc10x10-unorm" "astc10x10-unorm-srgb" "astc12x10-unorm" "astc12x10-unorm-srgb" "astc12x12-unorm" "astc12x12-unorm-srgb"))
    (export "gpu-texture-format" (type $gpu-texture-format (eq $fmt)))
    (type $opt-u32 (option u32))
    (type $opt-f32 (option f32))
    (type $opt-s32 (option s32))
    (type $ds (record
      (field "format" $gpu-texture-format)
      (field "depth-write-enabled" $opt-bool)
      (field "depth-compare" $opt-cmp)
      (field "stencil-front" $opt-sfs)
      (field "stencil-back" $opt-sfs)
      (field "stencil-read-mask" $opt-u32)
      (field "stencil-write-mask" $opt-u32)
      (field "depth-bias" $opt-s32)
      (field "depth-bias-slope-scale" $opt-f32)
      (field "depth-bias-clamp" $opt-f32)
    ))
    (export "gpu-depth-stencil-state" (type $gpu-depth-stencil-state (eq $ds)))
    (type $opt-ds (option $gpu-depth-stencil-state))
    (type $ms (record
      (field "count" $opt-u32)
      (field "mask" $opt-u32)
      (field "alpha-to-coverage-enabled" $opt-bool)
    ))
    (export "gpu-multisample-state" (type $gpu-multisample-state (eq $ms)))
    (type $opt-ms (option $gpu-multisample-state))
    (type $bf (enum "zero" "one" "src" "one-minus-src" "src-alpha" "one-minus-src-alpha" "dst" "one-minus-dst" "dst-alpha" "one-minus-dst-alpha" "src-alpha-saturated" "constant" "one-minus-constant" "src1" "one-minus-src1" "src1-alpha" "one-minus-src1-alpha"))
    (export "gpu-blend-factor" (type $gpu-blend-factor (eq $bf)))
    (type $bop (enum "add" "subtract" "reverse-subtract" "min" "max"))
    (export "gpu-blend-operation" (type $gpu-blend-operation (eq $bop)))
    (type $opt-bop (option $gpu-blend-operation))
    (type $opt-bf (option $gpu-blend-factor))
    (type $bc (record
      (field "operation" $opt-bop)
      (field "src-factor" $opt-bf)
      (field "dst-factor" $opt-bf)
    ))
    (export "gpu-blend-component" (type $gpu-blend-component (eq $bc)))
    (type $bs (record
      (field "color" $gpu-blend-component)
      (field "alpha" $gpu-blend-component)
    ))
    (export "gpu-blend-state" (type $gpu-blend-state (eq $bs)))
    (type $opt-bs (option $gpu-blend-state))
    (type $cw (flags "red" "green" "blue" "alpha" "all"))
    (export "gpu-color-write" (type $gpu-color-write (eq $cw)))
    (type $opt-cw (option $gpu-color-write))
    (type $cts (record
      (field "format" $gpu-texture-format)
      (field "blend" $opt-bs)
      (field "write-mask" $opt-cw)
    ))
    (export "gpu-color-target-state" (type $gpu-color-target-state (eq $cts)))
    (type $opt-cts (option $gpu-color-target-state))
    (type $list-opt-cts (list $opt-cts))
    (type $fs (record
      (field "targets" $list-opt-cts)
      (field "module" $borrow-shader)
      (field "entry-point" $opt-str)
      (field "constants" $opt-const)
    ))
    (export "gpu-fragment-state" (type $gpu-fragment-state (eq $fs)))
    (type $opt-fs (option $gpu-fragment-state))
    (type $desc (record
      (field "vertex" $gpu-vertex-state)
      (field "primitive" $opt-ps)
      (field "depth-stencil" $opt-ds)
      (field "multisample" $opt-ms)
      (field "fragment" $opt-fs)
      (field "layout" $gpu-layout-mode)
      (field "label" $opt-str)
    ))
    (export "gpu-render-pipeline-descriptor" (type $gpu-render-pipeline-descriptor (eq $desc)))
    (export "gpu-render-pipeline" (type $gpu-render-pipeline (sub resource)))
    (export "gpu-device" (type $gpu-device (sub resource)))
    (type $borrow-device (borrow $gpu-device))
    (type $own-pipeline (own $gpu-render-pipeline))
    (type $reason-def (enum "validation" "internal"))
    (export "gpu-pipeline-error-reason" (type $reason (eq $reason-def)))
    (type $kind-def (variant (case "gpu-pipeline-error" $reason)))
    (export "create-pipeline-error-kind" (type $kind (eq $kind-def)))
    (type $err-def (record (field "kind" $kind) (field "message" string)))
    (export "create-pipeline-error" (type $err (eq $err-def)))
    (type $result-pipeline (result $own-pipeline (error $err)))
    (type $create-ty (func async
      (param "self" $borrow-device)
      (param "descriptor" $gpu-render-pipeline-descriptor)
      (result $result-pipeline)))
    (export "[method]gpu-device.create-render-pipeline-async" (func (type $create-ty)))
    (type $own-device (own $gpu-device))
    (export "get-device" (func (result $own-device)))
    (type $own-shader (own $gpu-shader-module))
    (export "get-shader-module" (func (result $own-shader)))
  ))
  (alias export $webgpu "gpu-render-pipeline" (type $gpu-render-pipeline))
  (alias export $webgpu "get-device" (func $get-device))
  (alias export $webgpu "get-shader-module" (func $get-shader))
  (alias export $webgpu "[method]gpu-device.create-render-pipeline-async" (func $create-rp))

  (core module $builtins
    (memory (export "mem") 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (i32.const 256)
    )
  )
  (core instance $builtins (instantiate $builtins))

  (core func $gd_lower (canon lower (func $get-device)))
  (core func $gs_lower (canon lower (func $get-shader)))
  (core func $cr_lower
    (canon lower (func $create-rp)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $dp_lower (canon resource.drop $gpu-render-pipeline))

  (core module $m
    (import "" "mem" (memory 1))
    (import "" "get-device" (func $get-device (result i32)))
    (import "" "get-shader" (func $get-shader (result i32)))
    (import "" "create-rp" (func $create-rp (param i32 i32)))
    (import "" "drop-pipeline" (func $drop-pipeline (param i32)))
    (data (i32.const 768) "vs_main")
    (data (i32.const 784) "l2")
    (func (export "run") (result i32)
      (local $device i32)
      (local $shader i32)
      (local $retptr i32)
      (local $tag i32)
      (local $handle i32)
      (local.set $retptr (i32.const 512))
      (local.set $device (call $get-device))
      (local.set $shader (call $get-shader))
      ;; Spill tuple; zeros = none. vertex.module @16, layout auto disc @180.
      (i32.store (i32.const 0) (local.get $device))
      (i32.store (i32.const 16) (local.get $shader))
      (i32.store (i32.const 20) (i32.const 1))
      (i32.store (i32.const 24) (i32.const 768))
      (i32.store (i32.const 28) (i32.const 7))
      (i32.store (i32.const 180) (i32.const 1))
      (i32.store (i32.const 188) (i32.const 1))
      (i32.store (i32.const 192) (i32.const 784))
      (i32.store (i32.const 196) (i32.const 2))
      (call $create-rp (i32.const 0) (local.get $retptr))
      (local.set $tag (i32.load (local.get $retptr)))
      (local.set $handle (i32.load offset=4 (local.get $retptr)))
      (if (i32.eqz (local.get $tag))
        (then (call $drop-pipeline (local.get $handle))))
      (i32.const 1)
    )
  )
  (core instance $i (instantiate $m
    (with "" (instance
      (export "mem" (memory $builtins "mem"))
      (export "get-device" (func $gd_lower))
      (export "get-shader" (func $gs_lower))
      (export "create-rp" (func $cr_lower))
      (export "drop-pipeline" (func $dp_lower))
    ))
  ))
  (func (export "run") async (result u32)
    (canon lift (core func $i "run"))
  )
)
