;; WG-6: guest-drawn frame via gpu-canvas-context.get-current-texture (not host clear).
;; get-canvas-context + configure + get-device → shader + VERTEX buffer + pipeline →
;; get-current-texture → create-view → render pass → draw(3) → submit → drop owns.
;; Host presents after guest submit. Harness 1. get-* ctors are test-only.
;; Flattened configure is 15 i32s. Options are none.
(component
  (import "wasi:webgpu/webgpu@0.3.0-rc.2" (instance $webgpu
    (export "gpu-shader-module" (type $gpu-shader-module (sub resource)))
    (export "gpu-pipeline-layout" (type $gpu-pipeline-layout (sub resource)))
    (export "record-gpu-pipeline-constant-value" (type $record-const (sub resource)))
    (type $borrow-pll (borrow $gpu-pipeline-layout))
    (type $layout-mode-def (variant
      (case "specific" $borrow-pll)
      (case "auto")
    ))
    (export "gpu-layout-mode" (type $gpu-layout-mode (eq $layout-mode-def)))
    (type $borrow-shader (borrow $gpu-shader-module))
    (type $opt-str (option string))
    (type $opt-layout (option $gpu-layout-mode))
    (type $hint (record
      (field "entry-point" string)
      (field "layout" $opt-layout)
    ))
    (export "gpu-shader-module-compilation-hint" (type $gpu-shader-module-compilation-hint (eq $hint)))
    (type $list-hint (list $gpu-shader-module-compilation-hint))
    (type $opt-list-hint (option $list-hint))
    (type $shader-desc-def (record
      (field "code" string)
      (field "compilation-hints" $opt-list-hint)
      (field "label" $opt-str)
    ))
    (export "gpu-shader-module-descriptor" (type $gpu-shader-module-descriptor (eq $shader-desc-def)))
    (type $own-const (own $record-const))
    (type $opt-const (option $own-const))
    (type $vf (enum "uint8" "uint8x2" "uint8x4" "sint8" "sint8x2" "sint8x4" "unorm8" "unorm8x2" "unorm8x4" "snorm8" "snorm8x2" "snorm8x4" "uint16" "uint16x2" "uint16x4" "sint16" "sint16x2" "sint16x4" "unorm16" "unorm16x2" "unorm16x4" "snorm16" "snorm16x2" "snorm16x4" "float16" "float16x2" "float16x4" "float32" "float32x2" "float32x3" "float32x4" "uint32" "uint32x2" "uint32x3" "uint32x4" "sint32" "sint32x2" "sint32x3" "sint32x4" "unorm1010102" "unorm8x4-bgra"))
    (export "gpu-vertex-format" (type $gpu-vertex-format (eq $vf)))
    (type $attr (record
      (field "format" $gpu-vertex-format)
      (field "offset" u64)
      (field "shader-location" u32)
    ))
    (export "gpu-vertex-attribute" (type $gpu-vertex-attribute (eq $attr)))
    (type $step (enum "vertex" "instance"))
    (export "gpu-vertex-step-mode" (type $gpu-vertex-step-mode (eq $step)))
    (type $opt-step (option $gpu-vertex-step-mode))
    (type $list-attr (list $gpu-vertex-attribute))
    (type $vbl (record
      (field "array-stride" u64)
      (field "step-mode" $opt-step)
      (field "attributes" $list-attr)
    ))
    (export "gpu-vertex-buffer-layout" (type $gpu-vertex-buffer-layout (eq $vbl)))
    (type $opt-vbl (option $gpu-vertex-buffer-layout))
    (type $list-opt-vbl (list $opt-vbl))
    (type $opt-list-vbl (option $list-opt-vbl))
    (type $vs (record
      (field "buffers" $opt-list-vbl)
      (field "module" $borrow-shader)
      (field "entry-point" $opt-str)
      (field "constants" $opt-const)
    ))
    (export "gpu-vertex-state" (type $gpu-vertex-state (eq $vs)))
    (type $topo (enum "point-list" "line-list" "line-strip" "triangle-list" "triangle-strip"))
    (export "gpu-primitive-topology" (type $gpu-primitive-topology (eq $topo)))
    (type $idxf (enum "uint16" "uint32"))
    (export "gpu-index-format" (type $gpu-index-format (eq $idxf)))
    (type $ff (enum "ccw" "cw"))
    (export "gpu-front-face" (type $gpu-front-face (eq $ff)))
    (type $cull (enum "none" "front" "back"))
    (export "gpu-cull-mode" (type $gpu-cull-mode (eq $cull)))
    (type $opt-topo (option $gpu-primitive-topology))
    (type $opt-idxf (option $gpu-index-format))
    (type $opt-ff (option $gpu-front-face))
    (type $opt-cull (option $gpu-cull-mode))
    (type $opt-bool (option bool))
    (type $ps (record
      (field "topology" $opt-topo)
      (field "strip-index-format" $opt-idxf)
      (field "front-face" $opt-ff)
      (field "cull-mode" $opt-cull)
      (field "unclipped-depth" $opt-bool)
    ))
    (export "gpu-primitive-state" (type $gpu-primitive-state (eq $ps)))
    (type $opt-ps (option $gpu-primitive-state))
    (type $cmp (enum "never" "less" "equal" "less-equal" "greater" "not-equal" "greater-equal" "always"))
    (export "gpu-compare-function" (type $gpu-compare-function (eq $cmp)))
    (type $sop (enum "keep" "zero" "replace" "invert" "increment-clamp" "decrement-clamp" "increment-wrap" "decrement-wrap"))
    (export "gpu-stencil-operation" (type $gpu-stencil-operation (eq $sop)))
    (type $opt-cmp (option $gpu-compare-function))
    (type $opt-sop (option $gpu-stencil-operation))
    (type $sfs (record
      (field "compare" $opt-cmp)
      (field "fail-op" $opt-sop)
      (field "depth-fail-op" $opt-sop)
      (field "pass-op" $opt-sop)
    ))
    (export "gpu-stencil-face-state" (type $gpu-stencil-face-state (eq $sfs)))
    (type $opt-sfs (option $gpu-stencil-face-state))
    (type $fmt (enum "r8unorm" "r8snorm" "r8uint" "r8sint" "r16unorm" "r16snorm" "r16uint" "r16sint" "r16float" "rg8unorm" "rg8snorm" "rg8uint" "rg8sint" "r32uint" "r32sint" "r32float" "rg16unorm" "rg16snorm" "rg16uint" "rg16sint" "rg16float" "rgba8unorm" "rgba8unorm-srgb" "rgba8snorm" "rgba8uint" "rgba8sint" "bgra8unorm" "bgra8unorm-srgb" "rgb9e5ufloat" "rgb10a2uint" "rgb10a2unorm" "rg11b10ufloat" "rg32uint" "rg32sint" "rg32float" "rgba16unorm" "rgba16snorm" "rgba16uint" "rgba16sint" "rgba16float" "rgba32uint" "rgba32sint" "rgba32float" "stencil8" "depth16unorm" "depth24plus" "depth24plus-stencil8" "depth32float" "depth32float-stencil8" "bc1-rgba-unorm" "bc1-rgba-unorm-srgb" "bc2-rgba-unorm" "bc2-rgba-unorm-srgb" "bc3-rgba-unorm" "bc3-rgba-unorm-srgb" "bc4-r-unorm" "bc4-r-snorm" "bc5-rg-unorm" "bc5-rg-snorm" "bc6h-rgb-ufloat" "bc6h-rgb-float" "bc7-rgba-unorm" "bc7-rgba-unorm-srgb" "etc2-rgb8unorm" "etc2-rgb8unorm-srgb" "etc2-rgb8a1unorm" "etc2-rgb8a1unorm-srgb" "etc2-rgba8unorm" "etc2-rgba8unorm-srgb" "eac-r11unorm" "eac-r11snorm" "eac-rg11unorm" "eac-rg11snorm" "astc4x4-unorm" "astc4x4-unorm-srgb" "astc5x4-unorm" "astc5x4-unorm-srgb" "astc5x5-unorm" "astc5x5-unorm-srgb" "astc6x5-unorm" "astc6x5-unorm-srgb" "astc6x6-unorm" "astc6x6-unorm-srgb" "astc8x5-unorm" "astc8x5-unorm-srgb" "astc8x6-unorm" "astc8x6-unorm-srgb" "astc8x8-unorm" "astc8x8-unorm-srgb" "astc10x5-unorm" "astc10x5-unorm-srgb" "astc10x6-unorm" "astc10x6-unorm-srgb" "astc10x8-unorm" "astc10x8-unorm-srgb" "astc10x10-unorm" "astc10x10-unorm-srgb" "astc12x10-unorm" "astc12x10-unorm-srgb" "astc12x12-unorm" "astc12x12-unorm-srgb"))
    (export "gpu-texture-format" (type $gpu-texture-format (eq $fmt)))
    (type $opt-u32 (option u32))
    (type $opt-f32 (option f32))
    (type $opt-s32 (option s32))
    (type $ds (record
      (field "format" $gpu-texture-format)
      (field "depth-write-enabled" $opt-bool)
      (field "depth-compare" $opt-cmp)
      (field "stencil-front" $opt-sfs)
      (field "stencil-back" $opt-sfs)
      (field "stencil-read-mask" $opt-u32)
      (field "stencil-write-mask" $opt-u32)
      (field "depth-bias" $opt-s32)
      (field "depth-bias-slope-scale" $opt-f32)
      (field "depth-bias-clamp" $opt-f32)
    ))
    (export "gpu-depth-stencil-state" (type $gpu-depth-stencil-state (eq $ds)))
    (type $opt-ds (option $gpu-depth-stencil-state))
    (type $ms (record
      (field "count" $opt-u32)
      (field "mask" $opt-u32)
      (field "alpha-to-coverage-enabled" $opt-bool)
    ))
    (export "gpu-multisample-state" (type $gpu-multisample-state (eq $ms)))
    (type $opt-ms (option $gpu-multisample-state))
    (type $bf (enum "zero" "one" "src" "one-minus-src" "src-alpha" "one-minus-src-alpha" "dst" "one-minus-dst" "dst-alpha" "one-minus-dst-alpha" "src-alpha-saturated" "constant" "one-minus-constant" "src1" "one-minus-src1" "src1-alpha" "one-minus-src1-alpha"))
    (export "gpu-blend-factor" (type $gpu-blend-factor (eq $bf)))
    (type $bop (enum "add" "subtract" "reverse-subtract" "min" "max"))
    (export "gpu-blend-operation" (type $gpu-blend-operation (eq $bop)))
    (type $opt-bop (option $gpu-blend-operation))
    (type $opt-bf (option $gpu-blend-factor))
    (type $bc (record
      (field "operation" $opt-bop)
      (field "src-factor" $opt-bf)
      (field "dst-factor" $opt-bf)
    ))
    (export "gpu-blend-component" (type $gpu-blend-component (eq $bc)))
    (type $bs (record
      (field "color" $gpu-blend-component)
      (field "alpha" $gpu-blend-component)
    ))
    (export "gpu-blend-state" (type $gpu-blend-state (eq $bs)))
    (type $opt-bs (option $gpu-blend-state))
    (type $cw (flags "red" "green" "blue" "alpha" "all"))
    (export "gpu-color-write" (type $gpu-color-write (eq $cw)))
    (type $opt-cw (option $gpu-color-write))
    (type $cts (record
      (field "format" $gpu-texture-format)
      (field "blend" $opt-bs)
      (field "write-mask" $opt-cw)
    ))
    (export "gpu-color-target-state" (type $gpu-color-target-state (eq $cts)))
    (type $opt-cts (option $gpu-color-target-state))
    (type $list-opt-cts (list $opt-cts))
    (type $fs (record
      (field "targets" $list-opt-cts)
      (field "module" $borrow-shader)
      (field "entry-point" $opt-str)
      (field "constants" $opt-const)
    ))
    (export "gpu-fragment-state" (type $gpu-fragment-state (eq $fs)))
    (type $opt-fs (option $gpu-fragment-state))
    (type $desc (record
      (field "vertex" $gpu-vertex-state)
      (field "primitive" $opt-ps)
      (field "depth-stencil" $opt-ds)
      (field "multisample" $opt-ms)
      (field "fragment" $opt-fs)
      (field "layout" $gpu-layout-mode)
      (field "label" $opt-str)
    ))
    (export "gpu-render-pipeline-descriptor" (type $gpu-render-pipeline-descriptor (eq $desc)))
    (export "gpu-render-pipeline" (type $gpu-render-pipeline (sub resource)))
    (export "gpu-device" (type $gpu-device (sub resource)))
    (type $borrow-device (borrow $gpu-device))
    (type $own-pipeline (own $gpu-render-pipeline))
    (type $create-rp-ty (func
      (param "self" $borrow-device)
      (param "descriptor" $gpu-render-pipeline-descriptor)
      (result $own-pipeline)))
    (export "[method]gpu-device.create-render-pipeline" (func (type $create-rp-ty)))
    (type $own-device (own $gpu-device))
    (export "get-device" (func (result $own-device)))
    (type $own-shader (own $gpu-shader-module))
    (type $create-shader-ty (func
      (param "self" $borrow-device)
      (param "descriptor" $gpu-shader-module-descriptor)
      (result $own-shader)))
    (export "[method]gpu-device.create-shader-module" (func (type $create-shader-ty)))

    (type $usage (flags "map-read" "map-write" "copy-src" "copy-dst" "index" "vertex" "uniform" "storage" "indirect" "query-resolve"))
    (export "gpu-buffer-usage" (type $gpu-buffer-usage (eq $usage)))
    (type $opt-u64 (option u64))
    (type $buf-desc-def (record
      (field "size" u64)
      (field "usage" $gpu-buffer-usage)
      (field "mapped-at-creation" $opt-bool)
      (field "label" $opt-str)
    ))
    (export "gpu-buffer-descriptor" (type $gpu-buffer-descriptor (eq $buf-desc-def)))
    (export "gpu-buffer" (type $gpu-buffer (sub resource)))
    (type $own-buffer (own $gpu-buffer))
    (type $create-buf-ty (func
      (param "self" $borrow-device)
      (param "descriptor" $gpu-buffer-descriptor)
      (result $own-buffer)))
    (export "[method]gpu-device.create-buffer" (func (type $create-buf-ty)))

    (type $tex-usage (flags "copy-src" "copy-dst" "texture-binding" "storage-binding" "render-attachment" "transient-attachment"))
    (export "gpu-texture-usage" (type $tex-usage-ex (eq $tex-usage)))
    (type $texdim (enum "d1" "d2" "d3"))
    (export "gpu-texture-dimension" (type $texdim-ex (eq $texdim)))
    (type $viewdim (enum "d1" "d2" "d2-array" "cube" "cube-array" "d3"))
    (export "gpu-texture-view-dimension" (type $viewdim-ex (eq $viewdim)))
    (type $extent (record
      (field "width" u32)
      (field "height" $opt-u32)
      (field "depth-or-array-layers" $opt-u32)
    ))
    (export "gpu-extent3-d" (type $extent-ex (eq $extent)))
    (type $list-fmt (list $gpu-texture-format))
    (type $opt-list-fmt (option $list-fmt))
    (type $opt-texdim (option $texdim-ex))
    (type $opt-viewdim (option $viewdim-ex))
    (type $tex-desc-def (record
      (field "size" $extent-ex)
      (field "mip-level-count" $opt-u32)
      (field "sample-count" $opt-u32)
      (field "dimension" $opt-texdim)
      (field "format" $gpu-texture-format)
      (field "usage" $tex-usage-ex)
      (field "view-formats" $opt-list-fmt)
      (field "texture-binding-view-dimension" $opt-viewdim)
      (field "label" $opt-str)
    ))
    (export "gpu-texture-descriptor" (type $tex-desc-ex (eq $tex-desc-def)))
    (export "gpu-texture" (type $gpu-texture (sub resource)))
    (type $own-texture (own $gpu-texture))
    (type $asp (enum "all" "stencil-only" "depth-only"))
    (export "gpu-texture-aspect" (type $asp-ex (eq $asp)))
    (type $opt-fmt (option $gpu-texture-format))
    (type $opt-tex-usage (option $tex-usage-ex))
    (type $opt-asp (option $asp-ex))
    (type $view-desc-def (record
      (field "format" $opt-fmt)
      (field "dimension" $opt-viewdim)
      (field "usage" $opt-tex-usage)
      (field "aspect" $opt-asp)
      (field "base-mip-level" $opt-u32)
      (field "mip-level-count" $opt-u32)
      (field "base-array-layer" $opt-u32)
      (field "array-layer-count" $opt-u32)
      (field "swizzle" $opt-str)
      (field "label" $opt-str)
    ))
    (export "gpu-texture-view-descriptor" (type $view-desc-ex (eq $view-desc-def)))
    (export "gpu-texture-view" (type $gpu-texture-view (sub resource)))
    (type $borrow-tex (borrow $gpu-texture))
    (type $opt-view-desc (option $view-desc-ex))
    (type $own-view (own $gpu-texture-view))
    (type $create-view-ty (func
      (param "self" $borrow-tex)
      (param "descriptor" $opt-view-desc)
      (result $own-view)))
    (export "[method]gpu-texture.create-view" (func (type $create-view-ty)))

    (type $enc-desc-def (record (field "label" $opt-str)))
    (export "gpu-command-encoder-descriptor" (type $enc-desc-ex (eq $enc-desc-def)))
    (export "gpu-command-encoder" (type $gpu-command-encoder (sub resource)))
    (type $opt-enc-desc (option $enc-desc-ex))
    (type $own-encoder (own $gpu-command-encoder))
    (type $create-enc-ty (func
      (param "self" $borrow-device)
      (param "descriptor" $opt-enc-desc)
      (result $own-encoder)))
    (export "[method]gpu-device.create-command-encoder" (func (type $create-enc-ty)))

    (export "gpu-queue" (type $gpu-queue (sub resource)))
    (type $own-queue (own $gpu-queue))
    (export "[method]gpu-device.queue"
      (func (param "self" $borrow-device) (result $own-queue)))

    (export "gpu-query-set" (type $gpu-query-set (sub resource)))
    (type $borrow-view (borrow $gpu-texture-view))
    (type $borrow-qs (borrow $gpu-query-set))
    (type $load (enum "load" "clear"))
    (export "gpu-load-op" (type $load-ex (eq $load)))
    (type $storeop (enum "store" "discard"))
    (export "gpu-store-op" (type $store-ex (eq $storeop)))
    (type $color (record
      (field "r" f64)
      (field "g" f64)
      (field "b" f64)
      (field "a" f64)
    ))
    (export "gpu-color" (type $color-ex (eq $color)))
    (type $opt-view (option $borrow-view))
    (type $opt-color (option $color-ex))
    (type $color-att (record
      (field "view" $borrow-view)
      (field "depth-slice" $opt-u32)
      (field "resolve-target" $opt-view)
      (field "clear-value" $opt-color)
      (field "load-op" $load-ex)
      (field "store-op" $store-ex)
    ))
    (export "gpu-render-pass-color-attachment" (type $color-att-ex (eq $color-att)))
    (type $opt-color-att (option $color-att-ex))
    (type $list-opt-ca (list $opt-color-att))
    (type $opt-load (option $load-ex))
    (type $opt-store (option $store-ex))
    (type $ds-att (record
      (field "view" $borrow-view)
      (field "depth-clear-value" $opt-f32)
      (field "depth-load-op" $opt-load)
      (field "depth-store-op" $opt-store)
      (field "depth-read-only" $opt-bool)
      (field "stencil-clear-value" $opt-u32)
      (field "stencil-load-op" $opt-load)
      (field "stencil-store-op" $opt-store)
      (field "stencil-read-only" $opt-bool)
    ))
    (export "gpu-render-pass-depth-stencil-attachment" (type $ds-att-ex (eq $ds-att)))
    (type $ts-def (record
      (field "query-set" $borrow-qs)
      (field "beginning-of-pass-write-index" $opt-u32)
      (field "end-of-pass-write-index" $opt-u32)
    ))
    (export "gpu-render-pass-timestamp-writes" (type $ts-ex (eq $ts-def)))
    (type $opt-ds-att (option $ds-att-ex))
    (type $opt-qs (option $borrow-qs))
    (type $opt-ts (option $ts-ex))
    (type $rp-desc-def (record
      (field "color-attachments" $list-opt-ca)
      (field "depth-stencil-attachment" $opt-ds-att)
      (field "occlusion-query-set" $opt-qs)
      (field "timestamp-writes" $opt-ts)
      (field "max-draw-count" $opt-u64)
      (field "label" $opt-str)
    ))
    (export "gpu-render-pass-descriptor" (type $rp-desc-ex (eq $rp-desc-def)))
    (export "gpu-render-pass-encoder" (type $gpu-render-pass-encoder (sub resource)))
    (type $borrow-encoder (borrow $gpu-command-encoder))
    (type $own-pass (own $gpu-render-pass-encoder))
    (type $begin-ty (func
      (param "self" $borrow-encoder)
      (param "descriptor" $rp-desc-ex)
      (result $own-pass)))
    (export "[method]gpu-command-encoder.begin-render-pass" (func (type $begin-ty)))
    (export "[method]gpu-render-pass-encoder.end"
      (func (param "self" (borrow $gpu-render-pass-encoder))))

    (type $borrow-pipe (borrow $gpu-render-pipeline))
    (type $borrow-pass (borrow $gpu-render-pass-encoder))
    (export "[method]gpu-render-pass-encoder.set-pipeline"
      (func (param "self" $borrow-pass) (param "pipeline" $borrow-pipe)))

    (type $borrow-buf (borrow $gpu-buffer))
    (type $opt-buf (option $borrow-buf))
    (export "[method]gpu-render-pass-encoder.set-vertex-buffer"
      (func (param "self" $borrow-pass)
            (param "slot" u32)
            (param "buffer" $opt-buf)
            (param "offset" $opt-u64)
            (param "size" $opt-u64)))

    (export "[method]gpu-render-pass-encoder.draw"
      (func (param "self" $borrow-pass)
            (param "vertex-count" u32)
            (param "instance-count" $opt-u32)
            (param "first-vertex" $opt-u32)
            (param "first-instance" $opt-u32)))

    (type $cb-desc-def (record (field "label" $opt-str)))
    (export "gpu-command-buffer-descriptor" (type $cb-desc-ex (eq $cb-desc-def)))
    (export "gpu-command-buffer" (type $gpu-command-buffer (sub resource)))
    (type $opt-cb-desc (option $cb-desc-ex))
    (type $own-cb (own $gpu-command-buffer))
    (type $finish-ty (func
      (param "self" $borrow-encoder)
      (param "descriptor" $opt-cb-desc)
      (result $own-cb)))
    (export "[method]gpu-command-encoder.finish" (func (type $finish-ty)))

    (type $borrow-queue (borrow $gpu-queue))
    (type $borrow-cb (borrow $gpu-command-buffer))
    (type $list-cb (list $borrow-cb))
    (type $submit-ty (func
      (param "self" $borrow-queue)
      (param "command-buffers" $list-cb)))
    (export "[method]gpu-queue.submit" (func (type $submit-ty)))

    (type $canvas-cs (enum "srgb" "display-p3"))
    (export "predefined-color-space" (type $canvas-cs-ex (eq $canvas-cs)))
    (type $canvas-alpha (enum "opaque" "premultiplied"))
    (export "gpu-canvas-alpha-mode" (type $canvas-alpha-ex (eq $canvas-alpha)))
    (type $canvas-tm-mode (enum "standard" "extended"))
    (export "gpu-canvas-tone-mapping-mode" (type $canvas-tm-mode-ex (eq $canvas-tm-mode)))
    (type $opt-canvas-usage (option $tex-usage-ex))
    (type $opt-canvas-cs (option $canvas-cs-ex))
    (type $opt-canvas-tm-mode (option $canvas-tm-mode-ex))
    (type $canvas-tm (record (field "mode" $opt-canvas-tm-mode)))
    (export "gpu-canvas-tone-mapping" (type $canvas-tm-ex (eq $canvas-tm)))
    (type $opt-canvas-tm (option $canvas-tm-ex))
    (type $opt-canvas-alpha (option $canvas-alpha-ex))
    (export "gpu-canvas-context" (type $gpu-canvas-context (sub resource)))
    (type $canvas-cfg (record
      (field "device" $borrow-device)
      (field "format" $gpu-texture-format)
      (field "usage" $opt-canvas-usage)
      (field "view-formats" $opt-list-fmt)
      (field "color-space" $opt-canvas-cs)
      (field "tone-mapping" $opt-canvas-tm)
      (field "alpha-mode" $opt-canvas-alpha)
    ))
    (export "gpu-canvas-configuration" (type $canvas-cfg-ex (eq $canvas-cfg)))
    (type $borrow-ctx (borrow $gpu-canvas-context))
    (type $configure-ty (func
      (param "self" $borrow-ctx)
      (param "configuration" $canvas-cfg-ex)))
    (export "[method]gpu-canvas-context.configure" (func (type $configure-ty)))
    (type $get-tex-ty (func (param "self" $borrow-ctx) (result $own-texture)))
    (export "[method]gpu-canvas-context.get-current-texture" (func (type $get-tex-ty)))
    (type $own-ctx (own $gpu-canvas-context))
    (export "get-canvas-context" (func (result $own-ctx)))
  ))

  (alias export $webgpu "gpu-shader-module" (type $gpu-shader-module))
  (alias export $webgpu "gpu-buffer" (type $gpu-buffer))
  (alias export $webgpu "gpu-texture" (type $gpu-texture))
  (alias export $webgpu "gpu-texture-view" (type $gpu-texture-view))
  (alias export $webgpu "gpu-render-pipeline" (type $gpu-render-pipeline))
  (alias export $webgpu "gpu-command-encoder" (type $gpu-command-encoder))
  (alias export $webgpu "gpu-render-pass-encoder" (type $gpu-render-pass-encoder))
  (alias export $webgpu "gpu-queue" (type $gpu-queue))
  (alias export $webgpu "gpu-command-buffer" (type $gpu-command-buffer))
  (alias export $webgpu "get-device" (func $get-device))
  (alias export $webgpu "[method]gpu-device.create-shader-module" (func $create-shader))
  (alias export $webgpu "[method]gpu-device.create-buffer" (func $create-buffer))
  (alias export $webgpu "[method]gpu-device.create-render-pipeline" (func $create-rp))
  (alias export $webgpu "gpu-canvas-context" (type $gpu-canvas-context))
  (alias export $webgpu "get-canvas-context" (func $get-ctx))
  (alias export $webgpu "[method]gpu-canvas-context.configure" (func $configure))
  (alias export $webgpu "[method]gpu-canvas-context.get-current-texture" (func $get-tex))
  (alias export $webgpu "[method]gpu-texture.create-view" (func $create-view))
  (alias export $webgpu "[method]gpu-device.create-command-encoder" (func $create-encoder))
  (alias export $webgpu "[method]gpu-device.queue" (func $queue))
  (alias export $webgpu "[method]gpu-command-encoder.begin-render-pass" (func $begin))
  (alias export $webgpu "[method]gpu-render-pass-encoder.set-pipeline" (func $set-pipeline))
  (alias export $webgpu "[method]gpu-render-pass-encoder.set-vertex-buffer" (func $set-vb))
  (alias export $webgpu "[method]gpu-render-pass-encoder.draw" (func $draw))
  (alias export $webgpu "[method]gpu-render-pass-encoder.end" (func $end))
  (alias export $webgpu "[method]gpu-command-encoder.finish" (func $finish))
  (alias export $webgpu "[method]gpu-queue.submit" (func $submit))

  (core module $builtins
    (memory (export "mem") 1)
    (global $heap (mut i32) (i32.const 2048))
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (local $ptr i32)
      (local.set $ptr (global.get $heap))
      (global.set $heap (i32.add (global.get $heap) (local.get 3)))
      (local.get $ptr)
    )
  )
  (core instance $builtins (instantiate $builtins))

  (core func $gd_lower (canon lower (func $get-device)))
  (core func $gc_lower (canon lower (func $get-ctx)))
  (core func $cf_lower
    (canon lower (func $configure)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $gt_lower (canon lower (func $get-tex)))
  (core func $cs_lower
    (canon lower (func $create-shader)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $cb_lower
    (canon lower (func $create-buffer)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $cr_lower
    (canon lower (func $create-rp)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $cview_lower
    (canon lower (func $create-view)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $ce_lower
    (canon lower (func $create-encoder)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $q_lower (canon lower (func $queue)))
  (core func $b_lower
    (canon lower (func $begin)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $sp_lower (canon lower (func $set-pipeline)))
  (core func $svb_lower (canon lower (func $set-vb)))
  (core func $d_lower (canon lower (func $draw)))
  (core func $e_lower (canon lower (func $end)))
  (core func $f_lower
    (canon lower (func $finish)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $s_lower
    (canon lower (func $submit)
      (memory $builtins "mem")
      (realloc (func $builtins "realloc"))))
  (core func $dsh_lower (canon resource.drop $gpu-shader-module))
  (core func $dbuf_lower (canon resource.drop $gpu-buffer))
  (core func $dtex_lower (canon resource.drop $gpu-texture))
  (core func $dview_lower (canon resource.drop $gpu-texture-view))
  (core func $dpipe_lower (canon resource.drop $gpu-render-pipeline))
  (core func $de_lower (canon resource.drop $gpu-command-encoder))
  (core func $dp_lower (canon resource.drop $gpu-render-pass-encoder))
  (core func $dq_lower (canon resource.drop $gpu-queue))
  (core func $dcb_lower (canon resource.drop $gpu-command-buffer))

  (core module $m
    (import "" "mem" (memory 1))
    (import "" "get-device" (func $get-device (result i32)))
    (import "" "get-canvas-context" (func $get-ctx (result i32)))
    (import "" "configure" (func $configure
      (param i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "" "get-current-texture" (func $get-tex (param i32) (result i32)))
    (import "" "create-shader"
      (func $create-shader
        (param i32 i32 i32 i32 i32 i32 i32 i32 i32)
        (result i32)))
    (import "" "create-buffer"
      (func $create-buffer
        (param i32 i64 i32 i32 i32 i32 i32 i32)
        (result i32)))
    (import "" "create-rp" (func $create-rp (param i32) (result i32)))
    (import "" "create-view" (func $create-view (param i32) (result i32)))
    (import "" "create-encoder"
      (func $create-encoder (param i32 i32 i32 i32 i32) (result i32)))
    (import "" "queue" (func $queue (param i32) (result i32)))
    (import "" "begin" (func $begin (param i32) (result i32)))
    (import "" "set-pipeline" (func $set-pipeline (param i32 i32)))
    (import "" "set-vb"
      (func $set-vb (param i32 i32 i32 i32 i32 i64 i32 i64)))
    (import "" "draw" (func $draw (param i32 i32 i32 i32 i32 i32 i32 i32)))
    (import "" "end" (func $end (param i32)))
    (import "" "finish" (func $finish (param i32 i32 i32 i32 i32) (result i32)))
    (import "" "submit" (func $submit (param i32 i32 i32)))
    (import "" "drop-shader" (func $drop-shader (param i32)))
    (import "" "drop-buffer" (func $drop-buffer (param i32)))
    (import "" "drop-texture" (func $drop-texture (param i32)))
    (import "" "drop-view" (func $drop-view (param i32)))
    (import "" "drop-pipeline" (func $drop-pipeline (param i32)))
    (import "" "drop-encoder" (func $drop-encoder (param i32)))
    (import "" "drop-pass" (func $drop-pass (param i32)))
    (import "" "drop-queue" (func $drop-queue (param i32)))
    (import "" "drop-command-buffer" (func $drop-command-buffer (param i32)))
    (data (i32.const 768) "vs_main")
    (data (i32.const 784) "wg6")
    (data (i32.const 800) "fs_main")
    (data (i32.const 1024) "@vertex fn vs_main(@location(0) p: vec3<f32>) -> @builtin(position) vec4<f32> { return vec4<f32>(p, 1.0); } @fragment fn fs_main() -> @location(0) vec4<f32> { return vec4<f32>(0.0, 1.0, 0.0, 1.0); }")
    (func (export "run") (result i32)
      (local $device i32)
      (local $ctx i32)
      (local $shader i32)
      (local $buffer i32)
      (local $pipeline i32)
      (local $texture i32)
      (local $view i32)
      (local $encoder i32)
      (local $queue i32)
      (local $pass i32)
      (local $cb i32)
      (local $z i32)
      (local.set $device (call $get-device))
      (local.set $ctx (call $get-ctx))
      (call $configure
        (local.get $ctx)
        (local.get $device)
        (i32.const 21)
        (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0))
      (local.set $shader
        (call $create-shader
          (local.get $device)
          (i32.const 1024)
          (i32.const 198)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 1)
          (i32.const 784)
          (i32.const 3)))
      ;; VERTEX|COPY_DST = 40; 3 * float32x3 = 36
      (local.set $buffer
        (call $create-buffer
          (local.get $device)
          (i64.const 36)
          (i32.const 40)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)))
      (i32.store (i32.const 0) (local.get $device))
      (i32.store (i32.const 4) (i32.const 1))
      (i32.store (i32.const 8) (i32.const 256))
      (i32.store (i32.const 12) (i32.const 1))
      (i32.store (i32.const 16) (local.get $shader))
      (i32.store (i32.const 20) (i32.const 1))
      (i32.store (i32.const 24) (i32.const 768))
      (i32.store (i32.const 28) (i32.const 7))
      (i32.store8 (i32.const 40) (i32.const 1))
      (i32.store8 (i32.const 47) (i32.const 1))
      (i32.store8 (i32.const 48) (i32.const 2))
      ;; depth-stencil none — pass has no depth attachment
      (i32.store8 (i32.const 52) (i32.const 0))
      (i32.store (i32.const 256) (i32.const 1))
      (i64.store (i32.const 264) (i64.const 12))
      (i32.store (i32.const 276) (i32.const 320))
      (i32.store (i32.const 280) (i32.const 1))
      (i32.store (i32.const 320) (i32.const 29))
      (i64.store (i32.const 328) (i64.const 0))
      (i32.store (i32.const 336) (i32.const 0))
      (i32.store (i32.const 144) (i32.const 1))
      (i32.store (i32.const 148) (i32.const 400))
      (i32.store (i32.const 152) (i32.const 1))
      (i32.store (i32.const 156) (local.get $shader))
      (i32.store (i32.const 160) (i32.const 1))
      (i32.store (i32.const 164) (i32.const 800))
      (i32.store (i32.const 168) (i32.const 7))
      (i32.store8 (i32.const 400) (i32.const 1))
      (i32.store8 (i32.const 401) (i32.const 21))
      (i32.store8 (i32.const 415) (i32.const 1))
      (i32.store8 (i32.const 416) (i32.const 16))
      (i32.store (i32.const 180) (i32.const 1))
      (i32.store (i32.const 188) (i32.const 1))
      (i32.store (i32.const 192) (i32.const 784))
      (i32.store (i32.const 196) (i32.const 3))
      (local.set $pipeline (call $create-rp (i32.const 0)))
      ;; Drop create-rp spill leftovers so later none option discs stay 0.
      (local.set $z (i32.const 0))
      (loop $clear
        (i32.store (local.get $z) (i32.const 0))
        (local.set $z (i32.add (local.get $z) (i32.const 4)))
        (br_if $clear (i32.lt_u (local.get $z) (i32.const 768))))
      (local.set $texture (call $get-tex (local.get $ctx)))
      (i32.store (i32.const 64) (local.get $texture))
      (i32.store8 (i32.const 68) (i32.const 0))
      (local.set $view (call $create-view (i32.const 64)))
      (local.set $encoder
        (call $create-encoder
          (local.get $device)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)))
      (local.set $queue (call $queue (local.get $device)))
      (i32.store (i32.const 256) (local.get $encoder))
      (i32.store (i32.const 264) (i32.const 384))
      (i32.store (i32.const 268) (i32.const 1))
      (i32.store8 (i32.const 384) (i32.const 1))
      (i32.store (i32.const 392) (local.get $view))
      (i32.store8 (i32.const 416) (i32.const 1))
      (f64.store (i32.const 424) (f64.const 0))
      (f64.store (i32.const 432) (f64.const 0))
      (f64.store (i32.const 440) (f64.const 0))
      (f64.store (i32.const 448) (f64.const 1))
      (i32.store8 (i32.const 456) (i32.const 1))
      (i32.store8 (i32.const 457) (i32.const 0))
      (local.set $pass (call $begin (i32.const 256)))
      (call $set-pipeline (local.get $pass) (local.get $pipeline))
      (call $set-vb
        (local.get $pass)
        (i32.const 0)
        (i32.const 1) (local.get $buffer)
        (i32.const 0) (i64.const 0)
        (i32.const 0) (i64.const 0))
      (call $draw
        (local.get $pass)
        (i32.const 3)
        (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0)
        (i32.const 0) (i32.const 0))
      (call $end (local.get $pass))
      (call $drop-pass (local.get $pass))
      (local.set $cb
        (call $finish
          (local.get $encoder)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)))
      (i32.store (i32.const 16) (local.get $cb))
      (call $submit (local.get $queue) (i32.const 16) (i32.const 1))
      (call $drop-command-buffer (local.get $cb))
      (call $drop-queue (local.get $queue))
      (call $drop-encoder (local.get $encoder))
      (call $drop-view (local.get $view))
      (call $drop-texture (local.get $texture))
      (call $drop-pipeline (local.get $pipeline))
      (call $drop-buffer (local.get $buffer))
      (call $drop-shader (local.get $shader))
      (i32.const 1)
    )
  )
  (core instance $i (instantiate $m
    (with "" (instance
      (export "mem" (memory $builtins "mem"))
      (export "get-device" (func $gd_lower))
      (export "get-canvas-context" (func $gc_lower))
      (export "configure" (func $cf_lower))
      (export "get-current-texture" (func $gt_lower))
      (export "create-shader" (func $cs_lower))
      (export "create-buffer" (func $cb_lower))
      (export "create-rp" (func $cr_lower))
      (export "create-view" (func $cview_lower))
      (export "create-encoder" (func $ce_lower))
      (export "queue" (func $q_lower))
      (export "begin" (func $b_lower))
      (export "set-pipeline" (func $sp_lower))
      (export "set-vb" (func $svb_lower))
      (export "draw" (func $d_lower))
      (export "end" (func $e_lower))
      (export "finish" (func $f_lower))
      (export "submit" (func $s_lower))
      (export "drop-shader" (func $dsh_lower))
      (export "drop-buffer" (func $dbuf_lower))
      (export "drop-texture" (func $dtex_lower))
      (export "drop-view" (func $dview_lower))
      (export "drop-pipeline" (func $dpipe_lower))
      (export "drop-encoder" (func $de_lower))
      (export "drop-pass" (func $dp_lower))
      (export "drop-queue" (func $dq_lower))
      (export "drop-command-buffer" (func $dcb_lower))
    ))
  ))
  (func (export "run") async (result u32)
    (canon lift (core func $i "run"))
  )
)
