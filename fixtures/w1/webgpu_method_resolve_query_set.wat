;; S6+: get-encoder + get-query-set + get-buffer +
;; [method]gpu-command-encoder.resolve-query-set
;; WIT: resolve-query-set: func(query-set, first-query, query-count,
;;      destination, destination-offset)
;; Guest passes first-query=0, query-count=1, destination-offset=0;
;; drops owns; run returns harness 1. L2 unused (lift-only).
(component
  (import "wasi:webgpu/webgpu@0.3.0-rc.2" (instance $webgpu
    (export "gpu-buffer" (type $gpu-buffer (sub resource)))
    (export "gpu-query-set" (type $gpu-query-set (sub resource)))
    (export "gpu-command-encoder" (type $gpu-command-encoder (sub resource)))
    (type $borrow-qs (borrow $gpu-query-set))
    (type $borrow-buf (borrow $gpu-buffer))
    (type $borrow-enc (borrow $gpu-command-encoder))
    (type $resolve-ty (func
      (param "self" $borrow-enc)
      (param "query-set" $borrow-qs)
      (param "first-query" u32)
      (param "query-count" u32)
      (param "destination" $borrow-buf)
      (param "destination-offset" u64)))
    (export "[method]gpu-command-encoder.resolve-query-set" (func (type $resolve-ty)))
    (type $own-enc (own $gpu-command-encoder))
    (export "get-encoder" (func (result $own-enc)))
    (type $own-qs (own $gpu-query-set))
    (export "get-query-set" (func (result $own-qs)))
    (type $own-buf (own $gpu-buffer))
    (export "get-buffer" (func (result $own-buf)))
  ))
  (alias export $webgpu "gpu-buffer" (type $gpu-buffer))
  (alias export $webgpu "gpu-query-set" (type $gpu-query-set))
  (alias export $webgpu "get-encoder" (func $get-encoder))
  (alias export $webgpu "get-query-set" (func $get-query-set))
  (alias export $webgpu "get-buffer" (func $get-buffer))
  (alias export $webgpu "[method]gpu-command-encoder.resolve-query-set" (func $resolve))

  (core func $ge_lower (canon lower (func $get-encoder)))
  (core func $gq_lower (canon lower (func $get-query-set)))
  (core func $gb_lower (canon lower (func $get-buffer)))
  (core func $r_lower (canon lower (func $resolve)))
  (core func $dqs_lower (canon resource.drop $gpu-query-set))
  (core func $db_lower (canon resource.drop $gpu-buffer))

  (core module $m
    (import "" "get-encoder" (func $get-encoder (result i32)))
    (import "" "get-query-set" (func $get-query-set (result i32)))
    (import "" "get-buffer" (func $get-buffer (result i32)))
    (import "" "resolve"
      (func $resolve (param i32 i32 i32 i32 i32 i64)))
    (import "" "drop-query-set" (func $drop-query-set (param i32)))
    (import "" "drop-buffer" (func $drop-buffer (param i32)))
    (func (export "run") (result i32)
      (local $enc i32)
      (local $qs i32)
      (local $buf i32)
      (local.set $enc (call $get-encoder))
      (local.set $qs (call $get-query-set))
      (local.set $buf (call $get-buffer))
      (call $resolve
        (local.get $enc)
        (local.get $qs)
        (i32.const 0)
        (i32.const 1)
        (local.get $buf)
        (i64.const 0))
      (call $drop-query-set (local.get $qs))
      (call $drop-buffer (local.get $buf))
      (i32.const 1)
    )
  )
  (core instance $i (instantiate $m
    (with "" (instance
      (export "get-encoder" (func $ge_lower))
      (export "get-query-set" (func $gq_lower))
      (export "get-buffer" (func $gb_lower))
      (export "resolve" (func $r_lower))
      (export "drop-query-set" (func $dqs_lower))
      (export "drop-buffer" (func $db_lower))
    ))
  ))
  (func (export "run") async (result u32)
    (canon lift (core func $i "run"))
  )
)
