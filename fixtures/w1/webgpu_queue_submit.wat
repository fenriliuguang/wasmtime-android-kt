;; W3: wasi:webgpu/webgpu@0.3.0-rc.2#queue-submit1 (transitional flat, sync).
;; Not [method]gpu-queue.submit. Guest: adapter → device → queue + encoder → finish → submit;
;; return command-buffer u32 (submit is void).
(component
  (import "wasi:webgpu/webgpu@0.3.0-rc.2" (instance $webgpu
    (export "request-adapter" (func async (result u32)))
    (export "adapter-request-device" (func async (param "adapter" u32) (result u32)))
    (export "device-get-queue" (func (param "device" u32) (result u32)))
    (export "device-create-command-encoder" (func (param "device" u32) (result u32)))
    (export "command-encoder-finish" (func (param "encoder" u32) (result u32)))
    (export "queue-submit1" (func (param "queue" u32) (param "commands" u32)))
  ))
  (alias export $webgpu "request-adapter" (func $request-adapter))
  (alias export $webgpu "adapter-request-device" (func $adapter-request-device))
  (alias export $webgpu "device-get-queue" (func $device-get-queue))
  (alias export $webgpu "device-create-command-encoder" (func $device-create-command-encoder))
  (alias export $webgpu "command-encoder-finish" (func $command-encoder-finish))
  (alias export $webgpu "queue-submit1" (func $queue-submit1))

  (core module $m
    (import "" "request-adapter" (func $request-adapter (result i32)))
    (import "" "adapter-request-device" (func $adapter-request-device (param i32) (result i32)))
    (import "" "device-get-queue" (func $device-get-queue (param i32) (result i32)))
    (import "" "device-create-command-encoder" (func $device-create-command-encoder (param i32) (result i32)))
    (import "" "command-encoder-finish" (func $command-encoder-finish (param i32) (result i32)))
    (import "" "queue-submit1" (func $queue-submit1 (param i32 i32)))
    (func (export "run") (result i32)
      (local $adapter i32)
      (local $device i32)
      (local $queue i32)
      (local $encoder i32)
      (local $commands i32)
      (local.set $adapter (call $request-adapter))
      (local.set $device (call $adapter-request-device (local.get $adapter)))
      (local.set $queue (call $device-get-queue (local.get $device)))
      (local.set $encoder (call $device-create-command-encoder (local.get $device)))
      (local.set $commands (call $command-encoder-finish (local.get $encoder)))
      (call $queue-submit1 (local.get $queue) (local.get $commands))
      (local.get $commands)
    )
  )
  (core func $ra_lower (canon lower (func $request-adapter)))
  (core func $rd_lower (canon lower (func $adapter-request-device)))
  (core func $q_lower (canon lower (func $device-get-queue)))
  (core func $enc_lower (canon lower (func $device-create-command-encoder)))
  (core func $fin_lower (canon lower (func $command-encoder-finish)))
  (core func $sub_lower (canon lower (func $queue-submit1)))
  (core instance $i (instantiate $m
    (with "" (instance
      (export "request-adapter" (func $ra_lower))
      (export "adapter-request-device" (func $rd_lower))
      (export "device-get-queue" (func $q_lower))
      (export "device-create-command-encoder" (func $enc_lower))
      (export "command-encoder-finish" (func $fin_lower))
      (export "queue-submit1" (func $sub_lower))
    ))
  ))
  (func (export "run") async (result u32)
    (canon lift (core func $i "run"))
  )
)
