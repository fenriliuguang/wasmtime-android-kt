    (import "" "dispatch" (func $dispatch (param i32 i32 i32 i32 i32 i32)))
    (import "" "end" (func $end (param i32)))
    (import "" "finish" (func $finish (param i32 i32 i32 i32 i32) (result i32)))
    (import "" "submit" (func $submit (param i32 i32 i32)))
    (import "" "drop-shader" (func $drop-shader (param i32)))
    (import "" "drop-buffer" (func $drop-buffer (param i32)))
    (import "" "drop-bgl" (func $drop-bgl (param i32)))
    (import "" "drop-pll" (func $drop-pll (param i32)))
    (import "" "drop-pipeline" (func $drop-pipeline (param i32)))
    (import "" "drop-bg" (func $drop-bg (param i32)))
    (import "" "drop-encoder" (func $drop-encoder (param i32)))
    (import "" "drop-pass" (func $drop-pass (param i32)))
    (import "" "drop-queue" (func $drop-queue (param i32)))
    (import "" "drop-command-buffer" (func $drop-command-buffer (param i32)))
    (data (i32.const 32) "main")
    (data (i32.const 48) "wg6")
    (data (i32.const 64) "@group(0) @binding(0) var<storage, read_write> c : array<u32>;\n@compute @workgroup_size(1)\nfn main() { c[0] = 1u; }")
    (func (export "run") (result i32)
      (local $device i32)
      (local $shader i32)
      (local $buffer i32)
      (local $bgl i32)
      (local $pll i32)
      (local $pipeline i32)
      (local $bg i32)
      (local $encoder i32)
      (local $queue i32)
      (local $pass i32)
      (local $cb i32)
      (local.set $device (call $get-device))
      (local.set $shader
        (call $create-shader
          (local.get $device)
          (i32.const 64)
          (i32.const 115)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 1)
          (i32.const 48)
          (i32.const 3)))
      ;; STORAGE|COPY_DST|COPY_SRC = 140
      (local.set $buffer
        (call $create-buffer
          (local.get $device)
          (i64.const 4)
          (i32.const 140)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)))
      ;; One BGL entry at 256: binding=0, compute, buffer=storage.
      (i32.store (i32.const 256) (i32.const 0))
      (i32.store (i32.const 260) (i32.const 4))
      (i32.store (i32.const 264) (i32.const 1))
      (i32.store (i32.const 272) (i32.const 0x0101))
      (local.set $bgl
        (call $create-bgl
          (local.get $device)
          (i32.const 256)
          (i32.const 1)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)))
      ;; pipeline-layout list<option<borrow>>: some(bgl) at 400.
      (i32.store (i32.const 400) (i32.const 1))
      (i32.store (i32.const 404) (local.get $bgl))
      (local.set $pll
        (call $create-pll
          (local.get $device)
          (i32.const 400)
          (i32.const 1)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)))
      (local.set $pipeline
        (call $create-cp
          (local.get $device)
          (local.get $shader)
          (i32.const 1)
          (i32.const 32)
          (i32.const 4)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (local.get $pll)
          (i32.const 1)
          (i32.const 48)
          (i32.const 3)))
      ;; One bind-group entry at 512: binding=0, variant gpu-buffer + handle.
      (i32.store (i32.const 512) (i32.const 0))
      (i32.store (i32.const 520) (i32.const 0))
      (i32.store (i32.const 528) (local.get $buffer))
      (local.set $bg
        (call $create-bg
          (local.get $device)
          (local.get $bgl)
          (i32.const 512)
          (i32.const 1)
          (i32.const 1)
          (i32.const 48)
          (i32.const 3)))
      (local.set $encoder
        (call $create-encoder
          (local.get $device)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)))
      (local.set $queue (call $queue (local.get $device)))
      (local.set $pass
        (call $begin
          (local.get $encoder)
          (i32.const 0)
          (i32.const 0) (i32.const 0) (i32.const 0)
          (i32.const 0) (i32.const 0)
          (i32.const 0) (i32.const 0)
          (i32.const 0) (i32.const 0)))
      (call $set-pipeline (local.get $pass) (local.get $pipeline))
      (call $set-bind-group
        (local.get $pass)
        (i32.const 0)
        (i32.const 1) (local.get $bg)
        (i32.const 0) (i32.const 0) (i32.const 0)
        (i32.const 0) (i64.const 0)
        (i32.const 0) (i32.const 0)
        (i32.const 0))
      (call $dispatch
        (local.get $pass)
        (i32.const 1)
        (i32.const 1) (i32.const 1)
        (i32.const 1) (i32.const 1))
      (call $end (local.get $pass))
      (call $drop-pass (local.get $pass))
      (local.set $cb
        (call $finish
          (local.get $encoder)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)
          (i32.const 0)))
      (i32.store (i32.const 16) (local.get $cb))
      (call $submit (local.get $queue) (i32.const 16) (i32.const 1))
      (call $drop-command-buffer (local.get $cb))
      (call $drop-queue (local.get $queue))
      (call $drop-encoder (local.get $encoder))
      (call $drop-bg (local.get $bg))
      (call $drop-pipeline (local.get $pipeline))
      (call $drop-pll (local.get $pll))
      (call $drop-bgl (local.get $bgl))
      (call $drop-buffer (local.get $buffer))
      (call $drop-shader (local.get $shader))
      (i32.const 1)
    )
  )
  (core instance $i (instantiate $m
    (with "" (instance
      (export "mem" (memory $builtins "mem"))
      (export "get-device" (func $gd_lower))
      (export "create-shader" (func $cs_lower))
      (export "create-buffer" (func $cb_lower))
      (export "create-bgl" (func $cbgl_lower))
