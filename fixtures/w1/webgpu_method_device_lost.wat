;; S6+: get-device + [method]gpu-device.lost
;; WIT: lost: func() -> future<gpu-device-lost-info>. Await future; drop own; harness 1.
(component
  (import "wasi:webgpu/webgpu@0.3.0-rc.2" (instance $webgpu
    (export "gpu-device" (type $gpu-device (sub resource)))
    (export "gpu-device-lost-info" (type $gpu-device-lost-info (sub resource)))
    (type $borrow-dev (borrow $gpu-device))
    (type $own-info (own $gpu-device-lost-info))
    (type $ft (future $own-info))
    (type $lost-ty (func (param "self" $borrow-dev) (result $ft)))
    (export "[method]gpu-device.lost" (func (type $lost-ty)))
    (type $own-dev (own $gpu-device))
    (export "get-device" (func (result $own-dev)))
  ))
  (alias export $webgpu "gpu-device-lost-info" (type $gpu-device-lost-info))
  (type $own-info (own $gpu-device-lost-info))
  (type $ft (future $own-info))
  (alias export $webgpu "get-device" (func $get-device))
  (alias export $webgpu "[method]gpu-device.lost" (func $lost))

  (core module $builtins
    (memory (export "mem") 1)
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (i32.const 16)
    )
  )
  (core instance $builtins (instantiate $builtins))

  (core func $gd_lower (canon lower (func $get-device)))
  (core func $lost_lower (canon lower (func $lost) (memory $builtins "mem")))
  (core func $future.read (canon future.read $ft async (memory $builtins "mem")))
  (core func $future.drop-readable (canon future.drop-readable $ft))
  (core func $df_lower (canon resource.drop $gpu-device-lost-info))

  (core module $m
    (import "" "mem" (memory 1))
    (import "" "get-device" (func $get-device (result i32)))
    (import "" "lost" (func $lost (param i32) (result i32)))
    (import "" "future.read" (func $future.read (param i32 i32) (result i32)))
    (import "" "future.drop-readable" (func $future.drop-readable (param i32)))
    (import "" "drop-info" (func $drop-info (param i32)))
    (func (export "run") (result i32)
      (local $dev i32)
      (local $fut i32)
      (local $status i32)
      (local.set $dev (call $get-device))
      (local.set $fut (call $lost (local.get $dev)))
      (local.set $status (call $future.read (local.get $fut) (i32.const 0)))
      (if (i32.eq (local.get $status) (i32.const -1))
        (then unreachable))
      (call $drop-info (i32.load (i32.const 0)))
      (call $future.drop-readable (local.get $fut))
      (i32.const 1)
    )
  )
  (core instance $i (instantiate $m
    (with "" (instance
      (export "mem" (memory $builtins "mem"))
      (export "get-device" (func $gd_lower))
      (export "lost" (func $lost_lower))
      (export "future.read" (func $future.read))
      (export "future.drop-readable" (func $future.drop-readable))
      (export "drop-info" (func $df_lower))
    ))
  ))
  (func (export "run") async (result u32)
    (canon lift (core func $i "run"))
  )
)
